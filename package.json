{
  "name": "comandou-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@lucide/angular": "^1.79.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.8.0",
    "@angular-eslint/eslint-plugin-template": "^22.8.0",
    "@angular-eslint/template-parser": "^22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.2.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.8"
  }
}
