{
  "buildCommand": "ng build",
  "outputDirectory": "dist/comandou-web/browser",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!cardapio).*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "demo.comandou.app.br" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
